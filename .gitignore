# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.vercel

# vercel
.vercel*

# typescript
*.tsbuildinfo
next-env.d.ts

# temporary files
.tmp/

# Graphify: persist the knowledge graph + the expensive semantic (LLM) extraction
# cache so they travel with the repo (local, worktree, cloud). Commit graph.json
# (union-merged via .gitattributes), the report, labels, and cache/semantic/.
# Ignore: interpreter/root paths; manifest / stat-index / cost log (absolute paths
# + mtimes → churn and conflict on every clone); and cache/ast/ (free + fast to
# regenerate from tree-sitter, path-coupled so it never hits a fresh checkout, and
# rewritten on every run — pure churn with no cross-environment value).
/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/GRAPH_REPORT.md
!/graphify-out/.graphify_labels.json
!/graphify-out/cache/
/graphify-out/cache/stat-index.json
/graphify-out/cache/ast/

# Raw demo-video masters (commit only derived clips in docs/assets/demos/)
/demo-video/

# archived files
.archive/

# AI tool instruction files (non-Claude)
AGENTS.md

# Claude Code local/ephemeral files
.claude/settings.local.json
skills-lock.json

# Local agent/skill workspace artifacts
/.agent/
/.agents/
/.augment/
/.codex/*
!/.codex/hooks.json
!/.codex/skills/
!/.codex/skills/graphify/
!/.codex/skills/graphify/**
/.kiro/
/.playwright-mcp/
/skills/
/.impeccable.md
/.claude/skills/*
!/.claude/skills/graphify/
!/.claude/skills/graphify/**
!/.claude/skills/synthetic-traffic/
!/.claude/skills/synthetic-traffic/**

# README demo source assets — ship only explicit derived README assets
docs/assets/demos/*.mp4
!docs/assets/demos/polymorph-demo.mp4
docs/assets/demos/*-poster.png
