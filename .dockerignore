# Dependencies — reinstalled inside the image by `bun install`. Copying the
# host tree would clobber the freshly built linux binaries with host-platform
# (e.g. macOS/arm) ones and defeat the cache-separated install layer.
node_modules
**/node_modules

# Build output / caches — regenerated by `next build`
.next
out
coverage
*.tsbuildinfo
.turbo
.vite
.vite-temp

# Secrets and local env — supplied at build/run time via ARG/ENV, never baked in
.env
.env.*

# VCS and CI metadata
.git
.gitignore
.gitattributes
.github

# Editor / agent / tooling state
.vscode
.claude
.codex
.husky
.mcp.json

# Archived + generated artifacts not needed to build the app
.archive
graphify-out
.graphifyignore

# Large design / docs assets unused by the production build
polymorph.pen
claude-code-expert-review.html
claude-code-expert.skill
*.log
.DS_Store

# Docker + compose definitions themselves
Dockerfile
.dockerignore
docker-compose.yaml
